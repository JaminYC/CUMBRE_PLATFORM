AUTH_SERVICE_URL=http://localhost:3001
LEARNING_SERVICE_URL=http://localhost:3002
CONTENT_SERVICE_URL=http://localhost:3003
# El portal del estudiante NO consulta la base directamente, pero la ruta
# del tutor usa @cumbre/tutor-engine, que abre su propia conexion. Sin esta
# variable el tutor responde 500 y el panel se queda en "El tutor esta listo"
# sin llegar a contestar nunca.
DATABASE_URL=postgres://cumbre:cumbrepass@localhost:5432/cumbre

# La ruta por defecto se queda SIN definir a proposito.
#
# Este ejemplo traia "learning-path-placeholder", que es justamente el ID que
# la semilla de learning borra antes de sembrar. El panel del estudiante
# pedia esa ruta, recibia 404 y mostraba "No pudimos cargar esta vista" en
# lugar del saludo. En una maquina con .env.local ya creado no se notaba
# —prepare-env no lo pisa— pero en CI, que parte de cero, fallaba siempre.
#
# El valor bueno vive en lib/env.ts, al lado del codigo que lo usa, y coincide
# con services/learning_service/prisma/seed.ts. Descomenta esto solo para
# apuntar a otra ruta.
# NEXT_PUBLIC_DEFAULT_LEARNING_PATH_ID=

APP_SESSION_SECRET=change-me-student-session-secret
APP_SESSION_COOKIE_NAME=cumbre_student_session
APP_SESSION_COOKIE_DOMAIN=

# Auth: self-contained login by default. Set to "true" to redirect /login to the central portal (SSO).
# AUTH_USE_PORTAL=true
