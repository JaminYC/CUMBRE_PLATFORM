generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  // "native" para desarrollo en Windows/macOS; el segundo es el que
  // necesita el contenedor. Sin el, la imagen construye bien y revienta
  // al arrancar buscando un motor que no existe.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AuthUser {
  id                String   @id
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  metadata          Json?
  /// Institución dueña de la cuenta. Separa los datos de cada academia:
  /// sin esto, el administrador de una vería los usuarios de las demás.
  /// "cumbre" es el valor por defecto para no romper lo ya existente.
  tenant            String   @default("cumbre")
  primaryRole       String
  roles             String[]
  status            String
  displayName       String
  givenName         String?
  familyName        String?
  email             String?  @unique
  avatarUrl         String?
  locale            String?
  preferredLanguage String?
  timezone          String?
  externalRef       String?
  credentialHash    String?
  sessions          AuthSession[]

  /// Toda consulta de usuarios filtra por institución, así que conviene
  /// el índice desde el principio.
  @@index([tenant])
  @@map("auth_users")
}

model AuthSession {
  id                    String   @id
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  userId                String
  primaryRole           String
  roles                 String[]
  accessTokenHash       String   @unique
  refreshTokenHash      String   @unique
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  revokedAt             DateTime?
  lastUsedAt            DateTime?
  deviceId              String?
  userAgent             String?
  ipAddress             String?
  user                  AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accessTokenExpiresAt])
  @@index([refreshTokenExpiresAt])
  @@map("auth_sessions")
}
