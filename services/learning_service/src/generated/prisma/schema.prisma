generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  // "native" para desarrollo en Windows/macOS; el segundo es el que
  // necesita el contenedor. Sin el, la imagen construye bien y revienta
  // al arrancar buscando un motor que no existe.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model LearningPathRecord {
  id                       String                  @id
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  metadata                 Json?
  title                    String
  summary                  String?
  status                   String
  audienceRoles            String[]                @default([])
  topicIds                 String[]                @default([])
  skillIds                 String[]                @default([])
  lessonIds                String[]                @default([])
  projectIds               String[]                @default([])
  estimatedDurationMinutes Int?
  difficultyLevel          String?
  sequencingStrategy       String?
  sessions                 LearningSessionRecord[]
  classrooms               ClassroomRecord[]

  @@map("learning_paths")
}

model LearningSessionRecord {
  id                String              @id
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  metadata          Json?
  learnerUserId     String
  status            String
  learningPathId    String?
  lessonId          String?
  topicId           String?
  tutorSessionId    String?
  startedAt         DateTime
  endedAt           DateTime?
  progressPercent   Float
  difficultyLevel   String?
  masteryStateIds   String[]            @default([])
  recommendationIds String[]            @default([])
  learningPath      LearningPathRecord? @relation(fields: [learningPathId], references: [id], onDelete: SetNull)

  @@map("learning_sessions")
}

model MasteryStateRecord {
  id                    String   @id
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  metadata              Json?
  learnerUserId         String
  learningPathId        String?
  subjectType           String
  subjectId             String
  level                 String
  score                 Float
  confidence            Float
  evidenceCount         Int?
  trend                 String?
  lastObservedAt        DateTime
  recommendedDifficulty String?

  @@map("mastery_states")
}

model ClassroomRecord {
  id                      String                    @id
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  metadata                Json?
  name                    String
  gradeLevel              String
  subject                 String
  teacherId               String
  classCode               String                    @unique
  assignedModuleIds       String[]                  @default([])
  assignedLearningPathIds String[]                  @default([])
  learningPathId          String?
  learningPath            LearningPathRecord?       @relation(fields: [learningPathId], references: [id], onDelete: SetNull)
  enrollments             StudentEnrollmentRecord[]
  meetings                ClassroomMeetingRecord[]

  @@map("classrooms")
}

model ClassroomStudentProfileRecord {
  id                  String                    @id
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  metadata            Json?
  name                String
  email               String?
  gradeLevel          String
  createdByTeacher    Boolean
  linkedUserId        String?                   @unique
  generatedCredential String?
  enrollments         StudentEnrollmentRecord[]

  @@map("classroom_student_profiles")
}

model StudentEnrollmentRecord {
  id          String                        @id
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  metadata    Json?
  classroomId String
  studentId   String
  status      String
  joinedAt    DateTime?
  classroom   ClassroomRecord               @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student     ClassroomStudentProfileRecord @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classroomId, studentId])
  @@map("student_enrollments")
}

model ClassroomMeetingRecord {
  id                 String          @id
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  metadata           Json?
  classroomId        String
  provider           String
  title              String
  description        String?
  scheduledAt        DateTime
  meetingUrl         String
  createdByTeacherId String
  classroom          ClassroomRecord @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@map("classroom_meetings")
}

// ---------------------------------------------------------------------------
// Motor de practica — Academia Bryce / admision UNSA
//
// Vive aqui y no en content_service porque el camino caliente (servir pregunta,
// registrar respuesta, actualizar racha, decidir la siguiente) tiene que ser
// una transaccion local: cruzar de servicio seria un salto de red por pregunta.
//
// Las tablas llevan prefijo practica_ y el codigo vive en src/practica/ para
// que extraerlo a su propio servicio mas adelante sea mover carpetas.
// ---------------------------------------------------------------------------

model AsignaturaRecord {
  id        String       @id
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  eje       String
  nombre    String
  orden     Int
  temas     TemaRecord[]

  @@unique([eje, nombre])
  @@map("practica_asignaturas")
}

model TemaRecord {
  id           String           @id
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  asignaturaId String
  romano       String
  nombre       String
  // De aqui sale el modo secuencial. Es el orden del temario oficial, que no
  // es lo mismo que el orden de dificultad real: eso se mide despues.
  orden        Int
  bloque       String?
  asignatura   AsignaturaRecord @relation(fields: [asignaturaId], references: [id], onDelete: Cascade)
  preguntas    PreguntaRecord[]

  @@unique([asignaturaId, orden])
  @@map("practica_temas")
}

model PreguntaRecord {
  id             String     @id
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  temaId         String
  enunciado      String
  alternativas   Json
  claveCorrecta  String
  solucion       String?
  fuente         String?
  /// Figura que acompaña al enunciado, si la tiene.
  imagenUrl      String?
  /// El enunciado remite a una figura, un cuadro o un texto de lectura.
  ///
  /// Muchas preguntas de admision dicen "en la figura" o "segun el texto" y
  /// sin eso delante no se pueden resolver: el alumno solo puede adivinar.
  /// Marcarlas permite dejarlas en el banco —el enunciado y la clave son
  /// buenos— sin servirlas hasta que alguien les ponga la imagen. En cuanto
  /// `imagenUrl` deja de estar vacio, vuelven solas.
  requiereFigura Boolean    @default(false)
  // Las preguntas ancla salen de examenes reales y se reservan para medir
  // transferencia. Nunca entran al banco de practica.
  esAncla        Boolean    @default(false)
  // Dificultad estimada por Elo. Arranca en 0 y la mueven las respuestas.
  dificultad     Float      @default(0)
  vecesServida   Int        @default(0)
  activa         Boolean    @default(true)
  tema           TemaRecord @relation(fields: [temaId], references: [id], onDelete: Cascade)

  @@index([temaId, activa, esAncla])
  @@map("practica_preguntas")
}

model IntentoRecord {
  id            String   @id
  creadoEn      DateTime @default(now())
  alumnoId      String
  preguntaId    String
  temaId        String
  asignaturaId  String
  // "blanco" va aparte de "incorrecta" a proposito: en el examen de admision
  // dejar en blanco es una decision estrategica, no un fallo.
  resultado     String
  tiempoMs      Int
  modo          String
  perfil        String
  // Se guarda el theta del momento, no solo el actual, para poder reconstruir
  // el historico sin reprocesar toda la secuencia.
  thetaAlumno   Float?
  thetaPregunta Float?

  @@index([alumnoId, temaId, creadoEn])
  @@index([preguntaId])
  @@map("practica_intentos")
}

model ProgresoTemaRecord {
  id              String    @id
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  alumnoId        String
  temaId          String
  rachaActual     Int       @default(0)
  mejorRacha      Int       @default(0)
  intentosEnTema  Int       @default(0)
  // Dos etiquetas, no una: practicado responde "puede seguir avanzando",
  // consolidado responde "lo resolvera en el examen". La evidencia dice que
  // 3 al hilo sirve para lo primero y hace falta 5 para lo segundo.
  practicado      Boolean   @default(false)
  consolidado     Boolean   @default(false)
  theta           Float     @default(0)
  ultimoIntentoEn DateTime?

  @@unique([alumnoId, temaId])
  @@index([alumnoId, practicado])
  @@map("practica_progreso_temas")
}
