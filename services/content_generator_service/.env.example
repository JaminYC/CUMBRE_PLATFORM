# Content Generator Service — Environment Variables
# Copia este archivo como .env y rellena los valores

DATABASE_URL=postgresql://...@pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://db...supabase.co:5432/postgres

# AI Providers — al menos uno es requerido
# Si ambos están presentes, Anthropic se usa primero y OpenAI como fallback
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Supabase Storage
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Servicios opcionales (fallback si no están disponibles)
NOTEBOOKLM_SERVER_URL=http://localhost:8881
KOKORO_SERVER_URL=http://localhost:8880

AUTH_SERVICE_URL=http://localhost:3001
CONTENT_GENERATOR_PORT=3004
