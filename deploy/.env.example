# Copiar a `.env` en el VPS y completar. Este archivo si va al repositorio;
# el `.env` con los valores reales NO — ya esta ignorado.

# ── Dominio ──────────────────────────────────────────────────────────────
# Los servicios saldran por auth-api.DOMINIO, learning-api.DOMINIO y
# content-api.DOMINIO. Los tres subdominios necesitan un registro A
# apuntando a la IP del VPS ANTES de levantar el proxy: Caddy pide los
# certificados al arrancar y falla si el DNS todavia no resuelve.
DOMINIO=cumbre.teamvastoria.com

# Donde avisa Let's Encrypt si una renovacion falla. Que sea un correo que leas.
ACME_EMAIL=

# URL del portal, para los redirects de autenticacion.
PORTAL_URL=https://cumbre.teamvastoria.com

# ── Base de datos ────────────────────────────────────────────────────────
# Vive dentro de la misma maquina y no se expone a internet.
# La contrasena generala y no la reutilices de ningun otro sitio:
#   openssl rand -base64 32
POSTGRES_DB=cumbre
POSTGRES_USER=cumbre
POSTGRES_PASSWORD=

# ── Sesiones ─────────────────────────────────────────────────────────────
AUTH_ACCESS_TOKEN_TTL_MINUTES=30
AUTH_REFRESH_TOKEN_TTL_DAYS=30

# ── Registro ─────────────────────────────────────────────────────────────
# `debug` escupe muchisimo; en produccion, `info`.
LOG_LEVEL=info
