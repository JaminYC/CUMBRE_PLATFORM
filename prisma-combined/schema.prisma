generator client {
  provider = "prisma-client-js"
  output   = "../combined-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── AUTH SERVICE ──────────────────────────────────────────────
model AuthUser {
  id                String        @id
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  metadata          Json?
  primaryRole       String
  roles             String[]
  status            String
  displayName       String
  givenName         String?
  familyName        String?
  email             String?       @unique
  avatarUrl         String?
  locale            String?
  preferredLanguage String?
  timezone          String?
  externalRef       String?
  credentialHash    String?
  sessions          AuthSession[]
  @@map("auth_users")
}

model AuthSession {
  id                    String    @id
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  userId                String
  primaryRole           String
  roles                 String[]
  accessTokenHash       String    @unique
  refreshTokenHash      String    @unique
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  revokedAt             DateTime?
  lastUsedAt            DateTime?
  deviceId              String?
  userAgent             String?
  ipAddress             String?
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("auth_sessions")
}

// ── LEARNING SERVICE ──────────────────────────────────────────
model LearningPathRecord {
  id                       String                  @id
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  metadata                 Json?
  title                    String
  summary                  String?
  status                   String
  audienceRoles            String[]                @default([])
  topicIds                 String[]                @default([])
  skillIds                 String[]                @default([])
  lessonIds                String[]                @default([])
  projectIds               String[]                @default([])
  estimatedDurationMinutes Int?
  difficultyLevel          String?
  sequencingStrategy       String?
  sessions                 LearningSessionRecord[]
  classrooms               ClassroomRecord[]
  @@map("learning_paths")
}

model LearningSessionRecord {
  id                String             @id
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  metadata          Json?
  learnerUserId     String
  status            String
  learningPathId    String?
  lessonId          String?
  topicId           String?
  tutorSessionId    String?
  startedAt         DateTime
  endedAt           DateTime?
  progressPercent   Float
  difficultyLevel   String?
  masteryStateIds   String[]           @default([])
  recommendationIds String[]           @default([])
  learningPath      LearningPathRecord? @relation(fields: [learningPathId], references: [id], onDelete: SetNull)
  @@map("learning_sessions")
}

model MasteryStateRecord {
  id                    String   @id
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  metadata              Json?
  learnerUserId         String
  learningPathId        String?
  subjectType           String
  subjectId             String
  level                 String
  score                 Float
  confidence            Float
  evidenceCount         Int?
  trend                 String?
  lastObservedAt        DateTime
  recommendedDifficulty String?
  @@map("mastery_states")
}

model ClassroomRecord {
  id                      String                   @id
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  metadata                Json?
  name                    String
  gradeLevel              String
  subject                 String
  teacherId               String
  classCode               String                   @unique
  assignedModuleIds       String[]                 @default([])
  assignedLearningPathIds String[]                 @default([])
  learningPathId          String?
  learningPath            LearningPathRecord?      @relation(fields: [learningPathId], references: [id], onDelete: SetNull)
  enrollments             StudentEnrollmentRecord[]
  meetings                ClassroomMeetingRecord[]
  @@map("classrooms")
}

model ClassroomStudentProfileRecord {
  id                  String                   @id
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  metadata            Json?
  name                String
  email               String?
  gradeLevel          String
  createdByTeacher    Boolean
  linkedUserId        String?                  @unique
  generatedCredential String?
  enrollments         StudentEnrollmentRecord[]
  @@map("classroom_student_profiles")
}

model StudentEnrollmentRecord {
  id          String                        @id
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  metadata    Json?
  classroomId String
  studentId   String
  status      String
  joinedAt    DateTime?
  classroom   ClassroomRecord               @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student     ClassroomStudentProfileRecord @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([classroomId, studentId])
  @@map("student_enrollments")
}

model ClassroomMeetingRecord {
  id                 String          @id
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  metadata           Json?
  classroomId        String
  provider           String
  title              String
  description        String?
  scheduledAt        DateTime
  meetingUrl         String
  createdByTeacherId String
  classroom          ClassroomRecord @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  @@map("classroom_meetings")
}

// ── CONTENT SERVICE ───────────────────────────────────────────
model TopicRecord {
  id                   String         @id
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  metadata             Json?
  title                String
  summary              String?
  slug                 String?
  parentTopicId        String?
  skillIds             String[]       @default([])
  prerequisiteTopicIds String[]       @default([])
  lessons              LessonRecord[]
  @@map("content_topics")
}

model LessonRecord {
  id                       String      @id
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  metadata                 Json?
  title                    String
  summary                  String?
  lessonType               String
  topicId                  String
  skillIds                 String[]    @default([])
  learningObjectiveIds     String[]    @default([])
  prerequisiteLessonIds    String[]    @default([])
  estimatedDurationMinutes Int?
  difficultyLevel          String?
  resourceUrls             String[]    @default([])
  topic                    TopicRecord @relation(fields: [topicId], references: [id], onDelete: Cascade)
  @@map("content_lessons")
}

model ContentItemRecord {
  id           String   @id
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  metadata     Json?
  title        String
  summary      String?
  contentType  String
  status       String
  topicIds     String[] @default([])
  skillIds     String[] @default([])
  lessonId     String?
  assessmentId String?
  projectId    String?
  authorUserId String?
  sourceUrl    String?
  language     String?
  versionLabel String?
  @@map("content_items")
}

model TeachingMaterialRecord {
  id              String   @id
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  metadata        Json?
  teacherId       String
  fileName        String
  mimeType        String
  materialKind    String
  status          String
  parsedText      String
  parsedStructure Json
  sourceUrl       String?
  @@map("teaching_materials")
}

model TeachingModuleRecord {
  id                   String   @id
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  metadata             Json?
  teacherId            String
  materialId           String?
  title                String
  summary              String?
  status               String
  conceptNodeIds       String[] @default([])
  lessonIds            String[] @default([])
  sections             Json
  suggestedTopicTitles String[] @default([])
  @@map("teaching_modules")
}

model TeachingQuizRecord {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  metadata  Json?
  teacherId String
  moduleId  String?
  lessonId  String?
  title     String
  summary   String?
  questions Json
  @@map("teaching_quizzes")
}

model StudentAttemptRecord {
  id              String   @id
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  metadata        Json?
  studentId       String
  classroomId     String?
  quizId          String?
  source          String
  score           Float?
  answers         Json
  teacherVerified Boolean  @default(false)
  @@map("student_attempts")
}

model KnowledgeNodeRecord {
  id               String   @id
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  metadata         Json?
  nodeType         String
  title            String
  summary          String?
  sourceEntityType String?
  sourceEntityId   String?
  @@index([nodeType, sourceEntityType, sourceEntityId])
  @@map("knowledge_nodes")
}

model KnowledgeEdgeRecord {
  id           String   @id
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  metadata     Json?
  sourceNodeId String
  targetNodeId String
  edgeType     String
  label        String?
  weight       Float?
  directed     Boolean  @default(true)
  @@index([sourceNodeId, edgeType])
  @@index([targetNodeId, edgeType])
  @@map("knowledge_edges")
}

// ── TUTOR ENGINE ──────────────────────────────────────────────
model TutorSessionRecord {
  id                String            @id
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  metadata          Json?
  learnerUserId     String
  status            String
  tutorMode         String
  startedAt         DateTime
  lastInteractionAt DateTime
  learningPathId    String?
  lessonId          String?
  topicIds          String[]          @default([])
  goalSummary       String?
  turnCount         Int               @default(0)
  turns             TutorTurnRecord[]
  @@index([learnerUserId, lessonId, status, lastInteractionAt(sort: Desc)])
  @@map("tutor_sessions")
}

model TutorTurnRecord {
  id               String             @id
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  metadata         Json?
  retrievalContext Json?
  tutorSessionId   String
  actor            String
  action           String?
  responseType     String?
  title            String?
  summary          String?
  content          String
  lessonId         String?
  topicId          String?
  suggestedPrompts String[]           @default([])
  nextSteps        String[]           @default([])
  references       Json?
  contextSnippets  Json?
  tutorSession     TutorSessionRecord @relation(fields: [tutorSessionId], references: [id], onDelete: Cascade)
  @@index([tutorSessionId, createdAt])
  @@map("tutor_turns")
}

// ── CONTENT GENERATOR SERVICE ─────────────────────────────────
model GenerationJobRecord {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  role      String
  topic     String
  depth     String
  sources   Json
  outputs   String[]
  status    String
  results   Json?
  errorMsg  String?
  @@index([userId])
  @@index([status])
  @@map("generation_jobs")
}

model GenerationLimitRecord {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  role       String   @unique
  dailyLimit Int
  isActive   Boolean  @default(true)
  @@map("generation_limits")
}
